<?xml version=" 1.0\ encoding=\utf-8\?>
<network-security-config>
 <!-- OWASP MASVS: Enforce TLS for all production network traffic -->
 <base-config cleartextTrafficPermitted=\false\>
 <trust-anchors>
 <certificates src=\system\ />
 <certificates src=\user\ />
 </trust-anchors>
 </base-config>
</network-security-config>
