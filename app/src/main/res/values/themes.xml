<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Force Light Theme so Dark Mode never turns text white on white backgrounds -->
    <style name="Theme.NestyPOS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/nesty_burgundy</item>
        <item name="colorPrimaryVariant">@color/nesty_burgundy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nesty_gold</item>
        <item name="colorSecondaryVariant">@color/nesty_gold</item>
        <item name="colorOnSecondary">@color/nesty_burgundy_dark</item>

        <!-- Explicit text colors for crisp readability on POS screen -->
        <item name="android:textColor">@color/nesty_text_primary</item>
        <item name="android:textColorPrimary">@color/nesty_text_primary</item>
        <item name="android:textColorSecondary">@color/nesty_text_secondary</item>
        <item name="android:textColorHint">@color/nesty_text_secondary</item>
        <item name="editTextColor">@color/nesty_text_primary</item>

        <item name="android:statusBarColor">@color/nesty_burgundy_dark</item>
        <item name="android:windowBackground">@color/nesty_cream</item>
    </style>

    <style name="Theme.NestyPOS.Splash" parent="Theme.NestyPOS">
        <item name="android:windowBackground">@color/nesty_burgundy</item>
        <item name="android:statusBarColor">@color/nesty_burgundy_dark</item>
    </style>

    <style name="Theme.NestyPOS.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColor">@color/nesty_text_primary</item>
        <item name="android:textColorPrimary">@color/nesty_text_primary</item>
    </style>
</resources>
