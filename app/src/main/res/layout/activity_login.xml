<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nesty_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NESTY POS"
                android:textColor="@color/nesty_burgundy"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COUNTER OPERATOR LOGIN"
                android:textColor="@color/nesty_burgundy_dark"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Model 1008 • Built-in Thermal Printer"
                android:textColor="@color/nesty_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Login Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign In to Terminal"
                    android:textColor="@color/nesty_burgundy"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Operator ID Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Operator ID or Email"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/nesty_burgundy"
                    app:hintTextColor="@color/nesty_burgundy"
                    android:textColorHint="@color/nesty_text_secondary"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIdentifier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="operator@cvr.ac.in"
                        android:textColor="@color/nesty_text_primary"
                        android:textColorHint="@color/nesty_text_secondary"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password / PIN Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password or PIN"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/nesty_burgundy"
                    app:hintTextColor="@color/nesty_burgundy"
                    android:textColorHint="@color/nesty_text_secondary"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/nesty_burgundy"
                    android:layout_marginBottom="22dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="pos123"
                        android:textColor="@color/nesty_text_primary"
                        android:textColorHint="@color/nesty_text_secondary"
                        android:inputType="textPassword"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Login Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="SIGN IN TO TERMINAL"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/nesty_burgundy" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="@color/nesty_burgundy"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick Terminal Hint -->
        <TextView
            android:id="@+id/tvTerminalHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server: https://nesty-service-app.onrender.com/"
            android:textColor="@color/nesty_text_secondary"
            android:textSize="11sp"
            android:textAlignment="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
