<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Header Row: Order ID + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order #12345"
                android:textColor="@color/nesty_burgundy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tvDialogBillCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bill Code: A7B"
                android:textColor="@color/nesty_burgundy_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDialogPaymentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAID"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/bg_badge_paid"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </LinearLayout>

    <!-- Student Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_cream"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvDialogStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student: Test Student"
            android:textColor="@color/nesty_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogTxnId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Txn Ref: TXN123456"
            android:textColor="@color/nesty_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Items Section Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ITEMS ORDERED"
        android:textColor="@color/nesty_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="6dp" />

    <!-- Items Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="160dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvDialogItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 2x Samosa (Rs. 24.00)\n• 1x Cold Coffee (Rs. 60.00)"
            android:textColor="@color/nesty_text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp" />
    </ScrollView>

    <!-- Total Amount Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_divider_top">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TOTAL AMOUNT:"
            android:textColor="@color/nesty_burgundy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs. 84.00"
            android:textColor="@color/nesty_burgundy"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Close"
            android:textColor="@color/nesty_text_secondary"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogPrint"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="2"
            android:text="PRINT BILL"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/nesty_burgundy"
            app:cornerRadius="14dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>
